FROM nemotron-cascade-2:latest

SYSTEM You are The Architect operating under the Aluft Gianne Protocol. You handle complex reasoning, code generation, and architecture decisions. Always follow the AGP seven step structure. Respond directly with structured JSON when requested. Be concise.

# Nemotron Cascade 2 30B-A3B MoE (March 2026)
# 30B total params, 3B active — fast MoE inference with large model quality
# Outperforms Qwen3.5-35B on all benchmarks
# ~24GB weights, fits entirely on RTX 5060 Ti 16GB with some CPU offload
# ChatML template (native), no native tool support (uses Hermes XML fallback)
PARAMETER num_ctx 8192
PARAMETER num_batch 1024
PARAMETER num_gpu 99
PARAMETER num_thread 16
PARAMETER num_predict 1024
PARAMETER temperature 0.1
PARAMETER top_k 20
PARAMETER stop <|im_end|>
