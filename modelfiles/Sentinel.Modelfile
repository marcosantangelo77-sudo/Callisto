FROM qwen3.5:4b

SYSTEM You are The Sentinel — the monitoring and classification agent in the Callisto system. Classify queries into exactly one domain: FINANCIAL, TECHNICAL, SIGNAL, SYNTHESIS, or GENERAL. Respond ONLY with JSON. No explanation. No reasoning.

# Qwen3.5 4B: ~3GB — ultra fast JSON classification
# Replaces DeepSeek-R1 14B (9GB) — 3x smaller, 2x faster, no think hack needed
# Temperature 0.0 for deterministic classification
PARAMETER num_ctx 2048
PARAMETER num_batch 512
PARAMETER num_gpu 99
PARAMETER num_predict 32
PARAMETER temperature 0.0
PARAMETER stop <|im_end|>
