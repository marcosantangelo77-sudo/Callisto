# Callisto environment template — copy to .env and fill in real values.
# .env is gitignored; never commit secrets.

# ── Local model serving ──
OLLAMA_HOST=http://localhost:11434

# ── Search ──
BRAVE_API_KEY=
SEARXNG_URL=http://localhost:8888

# ── Odds providers ──
# odds-api.io Pro is the single source of truth. ODDS_API_KEY is the legacy
# odds-api.com creds (kept for historical compatibility; not on primary path).
# oddspapi was removed 2026-04-18 — do not re-add.
ODDS_API_KEY=
ODDS_API_IO_KEY=

# ── Telegram bot ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Service binding (audit C-2) ──
# Default 127.0.0.1. Only switch to 0.0.0.0 behind a reverse proxy with auth.
CALLISTO_PORT=8420
CALLISTO_BIND_HOST=127.0.0.1

# ── Admin auth (audit C-2) ──
# Required for /admin/*, /debug/*, /context/sync, /research/*, /executor/*,
# /bets/record, /backtest/run, etc. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CALLISTO_ADMIN_TOKEN=

# ── Database ──
# Move out of OneDrive when feasible (audit P2). Set
# CALLISTO_SILENCE_ONEDRIVE_WARNING=1 to suppress the recurring log warning.
CALLISTO_DB_PATH=memory/callisto.db
# CALLISTO_SILENCE_ONEDRIVE_WARNING=1

# ── Mode flags ──
# 1 = stay fully local (no Claude API, no external trackers). Default to 1 for
# safety; flip to 0 only when you intend to make external calls.
CALLISTO_LOCAL_ONLY=1
CALLISTO_HYBRID_MODE=0

# ── Sportsbook credentials (tools/credentials.py) ──
# Scrapers read these through get_credential("<book>", "<field>") — never
# via os.getenv directly. All fields optional: scrapers fall back to
# unauthenticated public endpoints when a session cookie is absent.
#
# Canonical naming: CALLISTO_<BOOK_SLUG>_<FIELD>
# Fields: USERNAME, PASSWORD, SESSION_COOKIE, API_KEY, API_SECRET,
#         ACCOUNT_ID, DEVICE_ID, TWO_FA_SECRET.

# DraftKings (primary sportsbook)
CALLISTO_DRAFTKINGS_USERNAME=
CALLISTO_DRAFTKINGS_PASSWORD=
CALLISTO_DRAFTKINGS_SESSION_COOKIE=
CALLISTO_DRAFTKINGS_ACCOUNT_ID=
CALLISTO_DRAFTKINGS_TWO_FA_SECRET=

# Fanatics (secondary sportsbook)
CALLISTO_FANATICS_USERNAME=
CALLISTO_FANATICS_PASSWORD=
CALLISTO_FANATICS_SESSION_COOKIE=
CALLISTO_FANATICS_ACCOUNT_ID=
CALLISTO_FANATICS_DEVICE_ID=

# FanDuel
CALLISTO_FANDUEL_USERNAME=
CALLISTO_FANDUEL_PASSWORD=
CALLISTO_FANDUEL_SESSION_COOKIE=
CALLISTO_FANDUEL_ACCOUNT_ID=

# BetMGM
CALLISTO_BETMGM_USERNAME=
CALLISTO_BETMGM_PASSWORD=
CALLISTO_BETMGM_SESSION_COOKIE=
CALLISTO_BETMGM_ACCOUNT_ID=

# Caesars / BetRivers / PointsBet (pregame only — no scrapers yet)
CALLISTO_CAESARS_USERNAME=
CALLISTO_CAESARS_PASSWORD=
CALLISTO_CAESARS_SESSION_COOKIE=
CALLISTO_BETRIVERS_USERNAME=
CALLISTO_BETRIVERS_PASSWORD=
CALLISTO_BETRIVERS_SESSION_COOKIE=
CALLISTO_POINTSBET_USERNAME=
CALLISTO_POINTSBET_PASSWORD=
CALLISTO_POINTSBET_SESSION_COOKIE=

# Pinnacle (sharp line reference — API only, no scraper)
CALLISTO_PINNACLE_USERNAME=
CALLISTO_PINNACLE_PASSWORD=
CALLISTO_PINNACLE_API_KEY=

# Canonical credential-manager forms for data providers (preferred).
# The legacy names above (ODDS_API_KEY etc.) still work via alias fallback.
CALLISTO_ODDS_API_IO_API_KEY=
CALLISTO_THE_ODDS_API_API_KEY=
CALLISTO_BRAVE_SEARCH_API_KEY=
CALLISTO_ACTION_NETWORK_API_KEY=
CALLISTO_TELEGRAM_API_KEY=

# Set to 1 to skip OS-keychain lookups entirely (headless / CI deploys).
# CALLISTO_DISABLE_KEYRING=1

# ── Bet executor safety knobs ──
EXECUTOR_MAX_BET_PCT=0.05
EXECUTOR_MAX_OPEN_EXPOSURE_PCT=0.25
EXECUTOR_DAILY_LOSS_PCT=0.20
EXECUTOR_MIN_EDGE=0.02
EXECUTOR_KELLY_FRACTION=0.25
EXECUTOR_MIN_BET=1.00
